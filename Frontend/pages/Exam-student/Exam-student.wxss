/* pages/Exam/Exam.wxss */
/* 整体背景 */
page{
  background-color: #f3f3f3;
}

/* 公告栏 */
.pubilcty-box{
  width: 93%;
  margin: 10rpx auto;
  margin-top: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
  overflow: hidden;
}
.publicity image {
  width: 100%;
  height: 300rpx;
}

/* 功能区域 */
.function{
  display: flex;
  justify-content: space-around;
  width: 93%;
  margin: 0 auto;
  margin-top: 20rpx;
}

/* 上传区域 */
.upload{
  width: 40%;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 下载区域 */
.download{
  width: 40%;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 功能图标 */
.img-ui image {
  width: 180rpx;
  height: 180rpx;
}

.img-ui2 image {
  width: 180rpx;
  height: 180rpx;
}

/* 功能文字 */
.function text {
  margin-top: 10rpx;
  font-size: 32rpx;
  color: #333;
}

/* 图片容器 */
.img-ui {
  position: relative;
}

/* 红点角标 */
.red-dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  border: 3rpx solid white;
  box-shadow: 0 0 10rpx rgba(255, 77, 79, 0.5);
}