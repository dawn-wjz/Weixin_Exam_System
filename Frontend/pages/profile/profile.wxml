<!-- pages/profile/profile.wxml -->
<view class="container">
  <view class="user-info">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/个人.png'}}"></image>
    <view class="user-details">
      <text class="user-name">{{userInfo.name || '未设置姓名'}}</text>
      <text class="user-role">{{userInfo.role === 'teacher' ? '教师' : '学生'}}</text>
      <text class="user-id">ID: {{userInfo.userId}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="toRegisterInfo">
      <text class="menu-text">注册信息</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>
</view>