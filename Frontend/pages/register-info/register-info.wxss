/* pages/register-info/register-info.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 头像区域 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin: 40rpx 0;
}

.avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
}

.avatar-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

/* 表单区域 */
.form-section {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  width: 750rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  width: 450rpx;
  margin: 0 auto;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 选择器样式 */
.picker-container {
  position: relative;
  width: 100%;
}

.picker-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background-color: #fff;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.picker-hidden {
  display: none;
}

/* 性别选择器 */
.gender-container {
  display: flex;
  gap: 40rpx;
}

.gender-item {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 120rpx;
  height: 60rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background-color: #fff;
}

.gender-item.selected {
  border-color: #07c160;
  background-color: #f0f9eb;
  color: #07c160;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.radio-item radio {
  margin-right: 10rpx;
}

/* 按钮区域 */
.button-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.register-button {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  border-radius: 10rpx;
  background-color: #07c160;
}

/* 媒体查询 */
@media (min-width: 768px) {
  .container {
    padding: 40rpx;
  }
  
  .form-section {
    padding: 50rpx;
  }
}